// Assignment 3 - Exercise 5: square using only constants and "+ 1"
//
// n * n = n + n + ... + n (n times), and each "+ n" is "+ 1" done n times.
// So: two nested loops, the inner one adds 1 to res exactly n times.
// Only  v := 0  and  v := v + 1  are used in the code.
// (Arbitrary arithmetic is allowed in invariants, and it is used there.)
//
// Outer invariant: after i full rounds, res == i * n
// Inner invariant: in round i, after j steps, res == i * n + j
//   inner loop ends with j == n  ->  res == i * n + n == (i + 1) * n
//   outer loop ends with i == n  ->  res == n * n
method square(n: Int) returns (res: Int)
    requires n >= 0
    ensures res == n * n
{
    res := 0
    var i: Int := 0
    while (i < n)
        invariant 0 <= i && i <= n
        invariant res == i * n
    {
        var j: Int := 0
        while (j < n)
            invariant 0 <= j && j <= n
            invariant res == i * n + j
        {
            res := res + 1
            j := j + 1
        }
        i := i + 1
    }
}

// small client to show the contract is usable
method client() {
    var r: Int
    r := square(7)
    assert r == 49
}
