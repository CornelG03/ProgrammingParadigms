// Assignment 4 - Exercise 2: McCarthy's 91 function terminates
//
// To prove termination in Viper we give a "decreases" clause: an expression
// (the termination measure / variant) that
//    1. gets strictly smaller at every recursive call, and
//    2. is bounded from below (for Int: the caller's value is >= 0).
// Then infinite recursion is impossible.
//
// Measure used here:  101 - n
// Recursive calls only happen when n <= 100, so the measure of the caller is
// 101 - n >= 1 (bounded).
//
//   Call 1:  M(n + 11)   measure 101 - (n + 11) = 90 - n   <  101 - n         ok
//
//   Call 2:  M(r), where r is the result of call 1. We know r from the
//            postcondition of M (this is why the "ensures" lines are needed
//            for the termination proof!):
//     case n + 11 > 100 (n >= 90):  r == n + 1
//            measure 101 - (n + 1) = 100 - n   <  101 - n                     ok
//     case n + 11 <= 100 (n <= 89): r == 91
//            measure 101 - 91 = 10             <  101 - n  (as n <= 89)       ok

import <decreases/int.vpr>

method M(n: Int) returns (r: Int)
    requires n >= 0
    ensures 100 < n ==> r == n - 10
    ensures n <= 100 ==> r == 91
    decreases 101 - n
{
    if (n > 100) {
        r := n - 10
    } else {
        r := M(n + 11)
        r := M(r)
    }
}
