// Assignment 4 - Exercise 4: Fibonacci
//
// Step 1: define fib as a (mathematical, side-effect free) Viper function.
//   Precondition: n >= 0  (fib is not defined for negative numbers; without it
//   the recursion fib(n - 1), fib(n - 2) would not be well-founded).
//   The definition on the slide, fib(n + 2) = fib(n + 1) + fib(n), is the same
//   as fib(n) = fib(n - 1) + fib(n - 2) for n >= 2.
//
// Step 2: the method. Postcondition: res == fib(n).
//   The loop keeps TWO consecutive Fibonacci numbers:
//       res  == fib(i)        next == fib(i + 1)
//   One iteration moves the window one step:
//       res'  = next       = fib(i + 1)
//       next' = res + next = fib(i) + fib(i + 1) = fib(i + 2)
//       i'    = i + 1
//   After the loop i == n (from i <= n and not i < n), so res == fib(n).

import <decreases/int.vpr>      // only needed for the "decreases" line

function fib(n: Int): Int
    requires n >= 0
    decreases n                 // optional: proves the definition terminates
{
    n <= 1 ? n : fib(n - 1) + fib(n - 2)
}

method iter_fib(n: Int) returns (res: Int)
    requires 0 <= n
    ensures res == fib(n)
{
    res := 0
    var i: Int := 0
    var next: Int := 1

    while (i < n)
        invariant 0 <= i && i <= n
        invariant res == fib(i)
        invariant next == fib(i + 1)
    {
        var t: Int := res
        res := next
        next := t + next
        i := i + 1
    }
}

// small client
method client() {
    var r: Int
    r := iter_fib(4)
    // Viper unfolds a recursive function only one level per mention, so we
    // walk up step by step: 0, 1, 1, 2, 3
    assert fib(0) == 0
    assert fib(1) == 1
    assert fib(2) == 1
    assert fib(3) == 2
    assert fib(4) == 3
    assert r == 3
}
